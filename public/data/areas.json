  {
    "id": "acondicionamiento-defensa",
    "name": "Acondicionamiento Físico y Defensa Personal",
    "shortName": "Acondicionamiento y Defensa",
    "tagline": "Resistencia, agilidad y capacidad de reacción táctica",
    "icon": "dumbbell",
    "accentColor": "#0284c7",
    "description": "La preparación corporal garantiza la resistencia física y mental necesaria para rendir las exigencias físicas requeridas en los procesos de postulación a escuelas matrices de las FF.AA. y de Orden, complementada con defensa militar basada en taekwondo y mimetismo en terreno.",
    "objectives": [
      "Desarrollar resistencia cardiovascular y fuerza física funcional para pruebas de admisión militar.",
      "Dominar ejercicios funcionales: trote, flexiones de brazo, abdominales, dominadas en barra y burpees.",
      "Aplicar técnicas de defensa militar basada en taekwondo y mimetismo táctico con pinturas."
    ],
    "heroImage": "./assets/images/peloton-premilitar/IMG_0063.webp",
    "equipment": [
      "Tatamis de goma EVA de alta densidad",
      "Barras de dominadas y estaciones de calistenia",
      "Sacos de impacto (pao) y guantillas",
      "Cronómetros y pulsómetros"
    ],
    "practicalExample": "Los estudiantes entrenan rutinas de trote de resistencia, series de flexiones, abdominales y burpees cronometrados emulando las tablas de evaluación física de las escuelas matrices, para luego ejecutar técnicas de defensa personal y mimetismo táctico en terreno.",
    "projects": [
      {
        "id": "preparacion-pruebas-fisicas",
        "title": "Preparación Física para Escuelas Matrices",
        "status": "Activo",
        "description": "Entrenamiento físico riguroso enfocado en cumplir y superar los estándares de las pruebas de admisión de las diversas escuelas de las Fuerzas Armadas y de Orden: desarrollo de resistencia cardiovascular mediante trote continuo, fortalecimiento muscular con flexiones de brazo, abdominales, dominadas en barra, burpees y circuitos de potencia física.",
        "image": "./assets/media/acondicionamiento-defensa/preparacion-pruebas-fisicas/IMG_0076.webp"
      },
      {
        "id": "defensa-personal-militar",
        "title": "Defensa Personal Militar (Base Taekwondo)",
        "status": "Activo",
        "description": "Instrucción de defensa militar y autoprotección fundamentada técnicamente en taekwondo: bloqueos de impacto, esquivas, técnicas de golpeo táctico, caídas, neutralización de agresiones y respuesta rápida bajo estrés físico.",
        "image": "./assets/media/acondicionamiento-defensa/defensa-personal-militar/IMG_0062_equipamiento.webp"
      },
      {
        "id": "mimetismo-camuflaje",
        "title": "Mimetismo y Camuflaje Táctico",
        "status": "Activo",
        "description": "Técnicas de ocultamiento y supervivencia táctica en terreno mediante pinturas faciales de camuflaje, adaptación a los colores y sombras de la vegetación, distorsión de la silueta humana y desplazamiento silencioso.",
        "image": "./assets/media/acondicionamiento-defensa/mimetismo-camuflaje/IMG_0060.webp"
      }
    ],
